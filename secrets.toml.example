# Copy this file to .streamlit/secrets.toml and put your own key in it.
# Never commit secrets.toml (it is listed in .gitignore).
GEMINI_API_KEY = "your-gemini-api-key"

# Optional: "Continue with Google" on the sign-in screen (also run: pip install Authlib).
# Create OAuth credentials in Google Cloud Console and add http://localhost:8501/oauth2callback as a redirect URI.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "a-long-random-string"
# client_id = "your-google-client-id"
# client_secret = "your-google-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
